{
  "name": "synapse",
  "productName": "Synapse",
  "version": "1.0.0",
  "description": "Synapse by zemskov.space — Local AI Workspace",
  "author": "zemskov.space",
  "license": "MIT",
  "keywords": [
    "ollama",
    "ai",
    "llm",
    "mcp",
    "electron",
    "local-ai",
    "openai",
    "sqlite"
  ],
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "build:app": "tsc && vite build",
    "preview": "vite preview",
    "start": "electron ."
  },
  "build": {
    "appId": "space.zemskov.synapse",
    "productName": "Synapse",
    "icon": "assets/icons/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/icons/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "mac": {
      "icon": "assets/icons/macos/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "icon": "assets/icons/windows/icon.ico"
    },
    "linux": {
      "icon": "assets/icons/linux/icons"
    }
  },
  "dependencies": {
    "@zemskov-space/harmonia": "^1.0.0",
    "lucide-react": "^0.454.0",
    "marked": "^14.1.3",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.8.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
